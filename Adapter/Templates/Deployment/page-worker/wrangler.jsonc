{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{application.kebabName}}",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
