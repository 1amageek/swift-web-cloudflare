{
  "schemaVersion": 3,
  "kind": "adapter",
  "id": "swift-web-cloudflare",
  "defaults": {
    "host": "worker",
    "deployment": "workers"
  },
  "hosts": {
    "worker": {
      "produces": ["swiftweb.cloudflare-worker-wasm"],
      "templates": [
        { "source": "Adapter/Templates/Host/worker", "destination": "wasm" }
      ],
      "variables": {
        "cloudflare.adapterTraits": "",
        "cloudflare.swiftSDK": "swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-14-a_wasm",
        "cloudflare.swiftToolchain": "org.swift.64202608141a"
      },
      "operations": {
        "build": [
          {
            "id": "swift-web-cloudflare.build-worker",
            "kind": "command",
            "executable": "sh",
            "arguments": ["build.sh"],
            "workingDirectory": "wasm",
            "environment": {
              "SWIFTWEB_HOSTED_APPLICATION": "1"
            }
          }
        ],
        "dev": [
          {
            "id": "swift-web-cloudflare.build-worker-for-development",
            "kind": "command",
            "executable": "sh",
            "arguments": ["build.sh"],
            "workingDirectory": "wasm",
            "environment": {
              "SWIFTWEB_HOSTED_APPLICATION": "1"
            }
          }
        ]
      }
    },
    "page-worker": {
      "produces": ["swiftweb.cloudflare-page-wasm"],
      "templates": [
        { "source": "Adapter/Templates/Host/worker", "destination": "wasm" }
      ],
      "variables": {
        "cloudflare.adapterTraits": ", traits: []",
        "cloudflare.swiftSDK": "swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-14-a_wasm-embedded",
        "cloudflare.swiftToolchain": "org.swift.64202608141a"
      },
      "operations": {
        "build": [
          {
            "id": "swift-web-cloudflare.build-page-worker",
            "kind": "command",
            "executable": "sh",
            "arguments": ["build.sh"],
            "workingDirectory": "wasm",
            "environment": {
              "SWIFTWEB_HOSTED_APPLICATION": "1",
              "JAVASCRIPTKIT_EXPERIMENTAL_EMBEDDED_WASM": "1"
            }
          }
        ],
        "dev": [
          {
            "id": "swift-web-cloudflare.build-page-worker-for-development",
            "kind": "command",
            "executable": "sh",
            "arguments": ["build.sh"],
            "workingDirectory": "wasm",
            "environment": {
              "SWIFTWEB_HOSTED_APPLICATION": "1",
              "JAVASCRIPTKIT_EXPERIMENTAL_EMBEDDED_WASM": "1"
            }
          }
        ]
      }
    }
  },
  "deployments": {
    "workers": {
      "accepts": ["swiftweb.cloudflare-worker-wasm"],
      "acceptsServiceArtifacts": ["cloudflare.external-durable-object"],
      "actorBindings": {
        "cloudflare.external-durable-object": {
          "hostRoute": {
            "transport": "swiftweb.http",
            "endpointPrefix": "cloudflare-do://{{service.name}}/"
          },
          "configuration": {
            "bindingName": "{{service.cloudflare.bindingName}}",
            "className": "{{service.cloudflare.className}}",
            "scriptName": "{{service.cloudflare.workerName}}"
          }
        }
      },
      "produces": ["cloudflare.worker-version"],
      "templates": [
        { "source": "Adapter/Templates/Deployment/common", "destination": "cloudflare" },
        { "source": "Adapter/Templates/Deployment/workers", "destination": "cloudflare" }
      ],
      "operations": {
        "prepare": [
          {
            "id": "swift-web-cloudflare.install-dependencies",
            "kind": "command",
            "executable": "npm",
            "arguments": ["ci"],
            "workingDirectory": "cloudflare",
            "inputs": ["cloudflare/package-lock.json"],
            "outputs": ["cloudflare/node_modules/.package-lock.json"]
          }
        ],
        "build": [
          {
            "id": "swift-web-cloudflare.configure-actor-services",
            "kind": "command",
            "executable": "node",
            "arguments": ["scripts/configure-actor-services.mjs"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.build-worker"]
          },
          {
            "id": "swift-web-cloudflare.typecheck",
            "kind": "command",
            "executable": "npm",
            "arguments": ["run", "typecheck"],
            "workingDirectory": "cloudflare",
            "environment": { "SWIFTWEB_PROJECT_ROOT": "{{project.root}}" },
            "dependsOn": ["swift-web-cloudflare.configure-actor-services"]
          },
          {
            "id": "swift-web-cloudflare.test",
            "kind": "command",
            "executable": "npm",
            "arguments": ["test"],
            "workingDirectory": "cloudflare",
            "environment": { "SWIFTWEB_PROJECT_ROOT": "{{project.root}}" },
            "dependsOn": ["swift-web-cloudflare.typecheck"]
          },
          {
            "id": "swift-web-cloudflare.validate-deployment",
            "kind": "command",
            "executable": "node",
            "arguments": ["scripts/validate-worker-bundle-size.mjs", "3145728"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.test"]
          }
        ],
        "dev": [
          {
            "id": "swift-web-cloudflare.dev",
            "kind": "command",
            "lifetime": "persistent",
            "executable": "npm",
            "arguments": ["run", "dev"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.build-worker-for-development"]
          }
        ],
        "deploy": [
          {
            "id": "swift-web-cloudflare.deploy",
            "kind": "command",
            "executable": "npm",
            "arguments": ["run", "deploy"],
            "workingDirectory": "cloudflare"
          }
        ]
      }
    },
    "page-worker": {
      "accepts": [
        "swiftweb.cloudflare-page-wasm",
        "swiftweb.cloudflare-worker-wasm"
      ],
      "acceptsServiceArtifacts": ["cloudflare.external-durable-object"],
      "actorBindings": {
        "cloudflare.external-durable-object": {
          "hostRoute": {
            "transport": "swiftweb.http",
            "endpointPrefix": "cloudflare-do://{{service.name}}/"
          },
          "configuration": {
            "bindingName": "{{service.cloudflare.bindingName}}",
            "className": "{{service.cloudflare.className}}",
            "scriptName": "{{service.cloudflare.workerName}}"
          }
        }
      },
      "produces": ["cloudflare.worker-version"],
      "templates": [
        { "source": "Adapter/Templates/Deployment/common", "destination": "cloudflare" },
        { "source": "Adapter/Templates/Deployment/page-worker", "destination": "cloudflare" }
      ],
      "operations": {
        "prepare": [
          {
            "id": "swift-web-cloudflare.install-dependencies",
            "kind": "command",
            "executable": "npm",
            "arguments": ["ci"],
            "workingDirectory": "cloudflare",
            "inputs": ["cloudflare/package-lock.json"],
            "outputs": ["cloudflare/node_modules/.package-lock.json"]
          }
        ],
        "build": [
          {
            "id": "swift-web-cloudflare.configure-actor-services",
            "kind": "command",
            "executable": "node",
            "arguments": ["scripts/configure-actor-services.mjs"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.build-page-worker"]
          },
          {
            "id": "swift-web-cloudflare.typecheck",
            "kind": "command",
            "executable": "npm",
            "arguments": ["run", "typecheck"],
            "workingDirectory": "cloudflare",
            "environment": { "SWIFTWEB_PROJECT_ROOT": "{{project.root}}" },
            "dependsOn": ["swift-web-cloudflare.configure-actor-services"]
          },
          {
            "id": "swift-web-cloudflare.test",
            "kind": "command",
            "executable": "npm",
            "arguments": ["test"],
            "workingDirectory": "cloudflare",
            "environment": { "SWIFTWEB_PROJECT_ROOT": "{{project.root}}" },
            "dependsOn": ["swift-web-cloudflare.typecheck"]
          },
          {
            "id": "swift-web-cloudflare.validate-deployment",
            "kind": "command",
            "executable": "node",
            "arguments": ["scripts/validate-worker-bundle-size.mjs", "3145728"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.test"]
          }
        ],
        "dev": [
          {
            "id": "swift-web-cloudflare.dev",
            "kind": "command",
            "lifetime": "persistent",
            "executable": "npm",
            "arguments": ["run", "dev"],
            "workingDirectory": "cloudflare",
            "dependsOn": ["swift-web-cloudflare.build-page-worker-for-development"]
          }
        ],
        "deploy": [
          {
            "id": "swift-web-cloudflare.deploy",
            "kind": "command",
            "executable": "npm",
            "arguments": ["run", "deploy"],
            "workingDirectory": "cloudflare"
          }
        ]
      }
    }
  },
  "services": {}
}
